{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/blank-react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ably/ably-php": "^1.1",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/framework": "^13.32",
        "laravel/reverb": "^1.11",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.0"
    },
    "require-dev": {
        "andreapollastri/checkpoint": "^1.1",
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.9",
        "laravel/pail": "^1.2",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "laravel/vet": "^0.2",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "types:generate": "@php artisan typescript:transform",
        "ssh:deploy": [
            "@ssh:deploy-fe",
            "@ssh:deploy-be"
        ],
        "ssh:deploy-be": [
            "./scotty run deploy_be"
        ],
        "ssh:deploy-fe": [
            "bun run build",
            "./scotty run deploy_fe"
        ],
        "ssh:get-scotty": [
            "curl -L https://github.com/spatie/scotty/releases/latest/download/scotty -o scotty",
            "chmod +x scotty",
            "./scotty list"
        ],
        "quality": [
            "Composer\\Config::disableProcessTimeout",
            "rector process",
            "pint",
            "bunx vp check --fix",
            "bun scripts/check-frontend-filenames.ts",
            "@php artisan wayfinder:generate --no-interaction",
            "bunx tsc --noEmit",
            "phpstan analyse",
            "vendor/bin/vet",
            "@php artisan checkpoint:scan --skip=\"NPM CVE Audit\" --json",
            "bunx knip --no-progress"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "laravel/vet": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
