APP_NAME=Antre
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://antre.example.com
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
TRUSTED_PROXIES=REMOTE_ADDR

DB_DATABASE=antre
DB_USERNAME=antre
DB_PASSWORD=
DB_ROOT_PASSWORD=

REVERB_APP_ID=antre
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_ALLOWED_ORIGINS=https://antre.example.com

# Leave the host empty to use the browser's current HTTPS hostname.
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Synology shared-folder path for persistent MariaDB and photo storage.
ANTRE_DATA_DIR=/volume1/docker/antre
ANTRE_HTTP_PORT=8080
